# Telegram API (https://my.telegram.org)
API_ID=123456
API_HASH=your_api_hash
# User session string (python generate_session.py) - used to LISTEN to channels
User_session=
# Bot token from @BotFather - admin commands and POSTING
BOT_TOKEN=123456:ABC...
# Only this Telegram user ID can control the bot
ADMIN_ID=123456789
# Supabase → Project Settings → Database → Connection string → URI (pooler, port 6543)
SUPABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
# Google AI Studio key
GEMINI_API_KEY=
